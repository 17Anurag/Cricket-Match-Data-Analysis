      <aliases enabled='yes' />
      <column caption='toss = win' datatype='string' name='[Calculation_1546250552553472]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [toss_winner] = [winner] THEN &quot;Toss Winner Won&quot;&#13;&#10;ELSE &quot;Toss Winner Lost&quot;&#13;&#10;END' />
      </column>
      <column caption='Win Method' datatype='string' name='[Calculation_1546250553909250]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [margin_runs] &gt; 0 THEN &quot;Won by Runs&quot;&#13;&#10;ELSEIF [margin_wickets] &gt; 0 THEN &quot;Won by Wickets&quot;&#13;&#10;ELSEIF [winning_method] = &quot;D/L&quot; THEN &quot;D/L Method&quot;&#13;&#10;ELSE &quot;Tie&quot;&#13;&#10;END' />
      </column>
      <column caption='Min(0)' datatype='integer' name='[Calculation_1546250555559940]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Min(0)' />
      </column>
      <column caption='Avg Team Score' datatype='real' name='[Calculation_1546250559791110]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([team_1_total_runs] + [team_2_total_runs]) / 2' />
      </column>
      <column caption='MIN(0)' datatype='integer' name='[Calculation_1546250577940488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='MIN(0)' />
      </column>
